---
import Layout from "../layouts/Layout.astro";
import InstallWizard from "../components/InstallWizard";
---

<Layout
  title="Install a screen · Pi Display"
  description="Install Pi Display on a Raspberry Pi, point it at an SMB share or Google Drive folder, and get a one-line setup command."
>
  <header class="flex flex-col gap-3 pt-20 pb-14">
    <h1 class="text-[40px] leading-12 font-semibold tracking-[-0.03em]">Install a screen</h1>
    <p class="text-base text-muted">Three steps from a fresh Pi to a running slideshow. Everything here stays in your browser.</p>
  </header>
  <InstallWizard client:load />
</Layout>
