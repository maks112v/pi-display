---
import Layout from "../layouts/Layout.astro";
import EventGenerator from "../components/EventGenerator";
---

<Layout
  title="Event generator · Pi Display"
  description="Play a separate folder on every screen on set dates and hours, once: download an event file and drop it in your media folder."
>
  <header class="flex flex-col gap-3 pt-20 pb-14">
    <h1 class="text-[40px] leading-12 font-semibold tracking-[-0.03em]">Event generator</h1>
    <p class="text-base text-muted">Play a folder of its own on set dates and hours, then go back to normal. Download the file and drop it next to the folder.</p>
  </header>
  <EventGenerator client:only="react" />
</Layout>
