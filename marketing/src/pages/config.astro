---
import Layout from "../layouts/Layout.astro";
import ConfigGenerator from "../components/ConfigGenerator";
---

<Layout
  title="Set up a screen · pi-display"
  description="Install pi-display on a Raspberry Pi, point it at an SMB share or Google Drive folder, and get a one-line setup command."
>
  <header class="flex flex-col gap-3 pt-20 pb-14">
    <h1 class="text-[40px] leading-12 font-semibold tracking-[-0.03em]">Set up a screen</h1>
    <p class="text-base text-muted">
      Five steps from a fresh Pi to a running slideshow. Everything here stays in your browser.
    </p>
  </header>
  <ConfigGenerator client:load />
</Layout>
