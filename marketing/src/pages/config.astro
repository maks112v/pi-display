---
import Layout from "../layouts/Layout.astro";
import ConfigWizard from "../components/ConfigWizard";
---

<Layout
  title="Config generator · pi-display"
  description="Set slideshow timing, fit, and schedules, then download a display.toml for your media folder or apply it to one Pi."
>
  <header class="flex flex-col gap-3 pt-20 pb-14">
    <h1 class="text-[40px] leading-12 font-semibold tracking-[-0.03em]">Config generator</h1>
    <p class="text-base text-muted">Set how your screens play. Save it as a file for the media folder, or apply it to one Pi.</p>
  </header>
  <ConfigWizard client:load />
</Layout>
