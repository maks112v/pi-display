---
import HeroFlow from "../components/HeroFlow.astro";
import HowItWorks from "../components/HowItWorks.astro";
import SupportedHardware from "../components/SupportedHardware.astro";
import Layout from "../layouts/Layout.astro";

const repo = "https://github.com/maks112v/pi-display";

const button = {
  primary: "rounded-md bg-fg px-5 py-3 text-[15px] font-medium text-bg hover:bg-muted",
  secondary: "rounded-md border border-edge px-5 py-3 text-[15px] font-medium hover:border-muted",
};

// Mirrors imageExts and videoExts in media.go.
const formats = [
  ...["JPEG", "PNG", "GIF", "WebP", "BMP"].map((name) => ({ name, kind: "image" })),
  ...["MP4", "MOV", "MKV", "WebM", "M4V", "AVI"].map((name) => ({ name, kind: "video" })),
];

// Each icon is drawn inline in the "Built to run unattended" section below.
const features = [
  { label: "Starts playing when the TV powers on", detail: "systemd service", icon: "power" },
  { label: "Keeps playing if the network drops", detail: "local copy, every 30s", icon: "offline" },
  { label: "Images and video, smooth on a Pi", detail: "hardware decoding", icon: "video" },
  { label: "Per-slide timing and fit", detail: "display.toml", icon: "sliders" },
  { label: "No accounts, apps or subscriptions", detail: "open source", icon: "unlocked" },
] as const;
---

<Layout
  title="Pi Display: simple digital signage for any TV"
  description="Put images and videos in a shared folder. Every Raspberry Pi connected to it plays them full screen, in order, from the moment it powers on."
>
  <section class="flex flex-col items-center gap-6 pt-24 pb-20 text-center sm:pt-30">
    <h1 class="max-w-[900px] text-4xl leading-tight font-semibold tracking-[-0.03em] sm:text-[56px] sm:leading-16">
      Simple digital signage for any TV.
    </h1>
    <p class="max-w-[560px] text-lg leading-7 text-muted">
      Point a Raspberry Pi at an SMB share, a Google Drive folder, or a local folder. It plays every image and video
      full screen, in order, from the moment it powers on.
    </p>
    <div class="flex gap-3 pt-3">
      <a href="/install" class={button.primary}>Set up a screen</a>
      <a href={repo} class={button.secondary}>View on GitHub</a>
    </div>
  </section>

  <HeroFlow />

  <section
    aria-label="Supported formats"
    class="mt-24 overflow-hidden border-y border-line py-5 mask-x-from-90% mask-x-to-100% motion-reduce:mask-none"
  >
    <ul
      class="flex w-max animate-marquee font-mono text-[13px] hover:[animation-play-state:paused] motion-reduce:w-auto motion-reduce:animate-none motion-reduce:flex-wrap motion-reduce:justify-center motion-reduce:gap-y-2"
    >
      {
        [...formats, ...formats].map((format, i) => (
          <li
            class:list={["flex items-baseline gap-2 pr-12", i >= formats.length && "motion-reduce:hidden"]}
            aria-hidden={i >= formats.length ? "true" : undefined}
          >
            <span>{format.name}</span>
            <span class="text-faint">{format.kind}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <HowItWorks />

  <section class="flex flex-col gap-12 pt-30">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between sm:gap-12">
      <h2 class="text-[32px] leading-10 font-semibold tracking-[-0.03em] sm:text-[40px] sm:leading-12">
        Built to run unattended
      </h2>
      <p class="max-w-[340px] text-[15px] leading-6 text-muted">
        Set it up once. It keeps the screen going through reboots, outages, and new files.
      </p>
    </div>
    <ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-5 lg:gap-0 lg:border-t lg:border-line">
      {
        features.map((feature) => (
          <li class="flex flex-col gap-3.5 border-t border-line pt-7 lg:border-t-0 lg:px-6 lg:first:pl-0 lg:last:pr-0 lg:not-first:border-l">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {feature.icon === "power" && <path d="M12 3 V11 M6.5 6.5 A7.5 7.5 0 1 0 17.5 6.5" />}
              {feature.icon === "offline" && (
                <>
                  <path d="M2.5 9 A14 14 0 0 1 21.5 9 M6 12.5 A9 9 0 0 1 18 12.5 M9.5 16 A4 4 0 0 1 14.5 16" />
                  <circle cx="12" cy="19.5" r="1" fill="currentColor" />
                  <path d="M3 3 L21 21" class="text-accent" />
                </>
              )}
              {feature.icon === "video" && (
                <>
                  <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
                  <path d="M10 9 L15 12 L10 15 Z" fill="currentColor" />
                </>
              )}
              {feature.icon === "sliders" && (
                <>
                  <path d="M4 6 H20 M4 12 H20 M4 18 H20" />
                  <circle cx="9" cy="6" r="2" class="fill-bg" />
                  <circle cx="15" cy="12" r="2" class="fill-bg" />
                  <circle cx="7" cy="18" r="2" class="fill-bg" />
                </>
              )}
              {feature.icon === "unlocked" && (
                <>
                  <rect x="4.5" y="10.5" width="15" height="10" rx="2" />
                  <path d="M8 10.5 V7.5 A4 4 0 0 1 15.5 5.5" />
                </>
              )}
            </svg>
            <h3 class="text-[17px] leading-6 font-semibold lg:min-h-12">{feature.label}</h3>
            <p class="font-mono text-xs text-muted">{feature.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <SupportedHardware />

  <section class="flex flex-col items-center gap-6 pt-40 text-center">
    <h2 class="text-4xl leading-tight font-semibold tracking-[-0.03em] sm:text-[56px] sm:leading-16">
      Set up your first screen
    </h2>
    <p class="text-lg leading-7 text-muted">Takes about five minutes.</p>
    <div class="flex gap-3 pt-3">
      <a href="/install" class={button.primary}>Install Pi Display</a>
      <a href="/docs" class={button.secondary}>Read the docs</a>
    </div>
  </section>
</Layout>
