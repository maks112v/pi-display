---
import HeroFlow from "../components/HeroFlow.astro";
import Layout from "../layouts/Layout.astro";

const repo = "https://github.com/maks112v/pi-display";

const button = {
  primary: "rounded-md bg-fg px-5 py-3 text-[15px] font-medium text-bg hover:bg-muted",
  secondary: "rounded-md border border-edge px-5 py-3 text-[15px] font-medium hover:border-muted",
};

const steps = [
  {
    title: "Connect a Pi to the TV",
    body: "Any Raspberry Pi running Raspberry Pi OS Lite. Plug it into HDMI and power.",
  },
  {
    title: "Run one setup command",
    body: "Generate it on this site with your share and login. Paste it on the Pi.",
  },
  {
    title: "Add files to the folder",
    body: "Screens pick up changes within a slide. Rename files to change the order.",
  },
];

const features = [
  { label: "Starts playing when the TV powers on", detail: "systemd service" },
  { label: "Keeps playing if the network drops", detail: "local copy, synced every 30s" },
  { label: "Images and video, smooth on a Pi", detail: "hardware decoding" },
  { label: "Per-slide timing and fit", detail: "display.toml" },
  { label: "No accounts, apps or subscriptions", detail: "open source" },
];
---

<Layout
  title="pi-display: simple digital signage for any TV"
  description="Put images and videos in a shared folder. Every Raspberry Pi connected to it plays them full screen, in order, from the moment it powers on."
>
  <section class="flex flex-col items-center gap-6 pt-24 pb-20 text-center sm:pt-30">
    <h1 class="max-w-[900px] text-4xl leading-tight font-semibold tracking-[-0.03em] sm:text-[56px] sm:leading-16">
      Simple digital signage for any TV.
    </h1>
    <p class="max-w-[560px] text-lg leading-7 text-muted">
      Point a Raspberry Pi at an SMB share, a Google Drive folder, or a local folder. It plays every image and video
      full screen, in order, from the moment it powers on.
    </p>
    <div class="flex gap-3 pt-3">
      <a href="/config" class={button.primary}>Set up a screen</a>
      <a href={repo} class={button.secondary}>View on GitHub</a>
    </div>
  </section>

  <HeroFlow />

  <section id="how-it-works" class="flex scroll-mt-8 flex-col gap-10 pt-30">
    <h2 class="text-[28px] font-semibold tracking-[-0.02em]">How it works</h2>
    <ol class="grid gap-12 md:grid-cols-3">
      {
        steps.map((step, i) => (
          <li class="flex flex-col gap-2.5 border-t border-edge pt-5">
            <span class="text-sm text-faint">{i + 1}</span>
            <h3 class="text-[17px] font-semibold">{step.title}</h3>
            <p class="text-[15px] leading-6 text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="grid gap-8 pt-30 md:grid-cols-3 md:gap-12">
    <h2 class="text-[28px] font-semibold tracking-[-0.02em]">Built to run unattended</h2>
    <ul class="border-b border-line text-[15px] md:col-span-2">
      {
        features.map((feature) => (
          <li class="flex justify-between gap-6 border-t border-line py-4">
            <span>{feature.label}</span>
            <span class="text-right text-faint">{feature.detail}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="flex flex-col justify-between gap-6 pt-30 sm:flex-row sm:items-center">
    <div class="flex flex-col gap-2">
      <h2 class="text-[28px] font-semibold tracking-[-0.02em]">Set up your first screen</h2>
      <p class="text-[15px] text-muted">Takes about five minutes.</p>
    </div>
    <div class="flex gap-3">
      <a href="/config" class={button.primary}>Open config generator</a>
      <a href={`${repo}#readme`} class={button.secondary}>Read the docs</a>
    </div>
  </section>
</Layout>
