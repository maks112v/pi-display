---
// The Pi Display mark: a screen with a π on it. Draws in currentColor.
// public/favicon.svg is the same drawing with a heavier stroke.
interface Props {
  size?: number;
}

const { size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="3.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <rect x="4" y="7" width="40" height="28" rx="3.5"></rect>
  <path d="M14 16 H34 M19.5 16 V28 M28.5 16 V25.5 Q28.5 28 31 28 M17 42 H31"></path>
</svg>
