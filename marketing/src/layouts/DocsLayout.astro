---
// Docs shell: top bar with search, grouped sidebar, the page, and an
// "On this page" list. Pages come from src/content/docs via [...slug].astro.
import type { MarkdownHeading } from "astro";
import "../styles/global.css";
import DocsSearch from "../components/DocsSearch";
import DocsSidebar from "../components/DocsSidebar.astro";
import { searchIndex, type DocPage } from "../lib/docs";

interface Props {
  page: DocPage;
  prev: DocPage | undefined;
  next: DocPage | undefined;
  headings: MarkdownHeading[];
}

const { page, prev, next, headings } = Astro.props;
const index = await searchIndex();
const repo = "https://github.com/maks112v/pi-display";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={page.data.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{page.id === "index" ? "Docs · pi-display" : `${page.data.title} · pi-display docs`}</title>
  </head>
  <body class="bg-bg font-sans text-fg antialiased">
    <header class="sticky top-0 z-20 flex h-16 items-center gap-6 border-b border-line bg-bg px-5 lg:gap-8 lg:px-8">
      <a href="/" class="flex shrink-0 items-center gap-2.5 lg:w-60">
        <svg width="20" height="16" viewBox="0 0 20 16" fill="none" aria-hidden="true">
          <rect x="1" y="1" width="18" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>
          <path d="M7 15 H13" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
        <span class="text-[15px] font-semibold">pi-display</span>
        <span class="text-[15px] text-faint">Docs</span>
      </a>
      <div class="flex min-w-0 flex-1 justify-end sm:justify-center">
        <DocsSearch client:load index={index} />
      </div>
      <div class="hidden shrink-0 items-center justify-end gap-6 sm:flex lg:w-60">
        <a href={repo} class="text-sm text-muted hover:text-fg">GitHub</a>
        <a href="/config" class="flex h-8 items-center rounded-md bg-fg px-3.5 text-[13px] font-medium text-bg hover:bg-muted">
          Set up a screen
        </a>
      </div>
    </header>

    <div class="flex items-start gap-8 px-5 lg:px-8">
      <nav aria-label="Docs" class="sticky top-16 hidden max-h-[calc(100vh-4rem)] w-60 shrink-0 overflow-y-auto pt-10 pb-10 lg:block">
        <DocsSidebar current={page.id} />
      </nav>

      <main class="flex min-w-0 flex-1 justify-center pt-10 pb-24 lg:pt-12">
        <article class="w-full max-w-[680px]">
          <details class="group mb-8 border-y border-line lg:hidden">
            <summary class="flex h-11 cursor-pointer list-none items-center justify-between text-sm text-muted">
              Menu
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="group-open:rotate-180">
                <path d="M2.5 4.5 L6 8 L9.5 4.5" stroke="currentColor" stroke-width="1.5"></path>
              </svg>
            </summary>
            <div class="pb-6"><DocsSidebar current={page.id} /></div>
          </details>

          <header class="flex flex-col gap-2.5 pb-10">
            <span class="text-[13px] font-medium text-faint">{page.group}</span>
            <h1 class="text-[32px] leading-10 font-semibold tracking-[-0.025em]">{page.data.title}</h1>
            <p class="text-[17px] leading-7 text-muted">{page.data.description}</p>
          </header>

          <div class="prose"><slot /></div>

          {
            (prev || next) && (
              <div class="mt-16 flex gap-4 border-t border-line pt-6">
                {prev && (
                  <a href={prev.href} class="group flex flex-1 flex-col gap-1">
                    <span class="text-[13px] text-faint">Previous</span>
                    <span class="text-[15px] font-medium group-hover:text-muted">{prev.data.title}</span>
                  </a>
                )}
                {next && (
                  <a href={next.href} class="group ml-auto flex flex-1 flex-col items-end gap-1 text-right">
                    <span class="text-[13px] text-faint">Next</span>
                    <span class="text-[15px] font-medium group-hover:text-muted">{next.data.title}</span>
                  </a>
                )}
              </div>
            )
          }
        </article>
      </main>

      <aside class="sticky top-16 hidden w-60 shrink-0 flex-col gap-2.5 pt-[52px] xl:flex">
        {
          headings.length > 0 && (
            <>
              <span class="pb-1 text-xs font-medium text-faint">On this page</span>
              {headings.map((h) => (
                <a href={`#${h.slug}`} class="text-[13px] text-muted hover:text-fg">
                  {h.text}
                </a>
              ))}
              <div class="my-2 border-t border-line" />
            </>
          )
        }
        <a href={`${repo}/edit/main/marketing/src/content/docs/${page.id}.md`} class="text-[13px] text-faint hover:text-fg">
          Edit on GitHub
        </a>
      </aside>
    </div>

    <script>
      // Copy buttons on code blocks (added at build time in astro.config.mjs).
      document.addEventListener("click", (event) => {
        const button = event.target instanceof Element ? event.target.closest("[data-copy]") : null;
        const code = button?.closest(".code-block")?.querySelector("code");
        if (!button || !code) return;
        navigator.clipboard.writeText(code.innerText.trimEnd()).then(() => {
          button.textContent = "Copied";
          setTimeout(() => (button.textContent = "Copy"), 2000);
        });
      });
    </script>
  </body>
</html>

