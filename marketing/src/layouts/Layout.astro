---
// Shared page shell: document head, nav, and the centered content column.
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import ShareMeta from "../components/ShareMeta.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const links = [
  { label: "How it works", href: "/#how-it-works" },
  { label: "Docs", href: "/docs" },
  { label: "GitHub", href: "https://github.com/maks112v/pi-display" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ShareMeta title={title} description={description} />
  </head>
  <body class="bg-bg font-sans text-fg antialiased">
    <div class="mx-auto max-w-[1168px] px-6 pb-24">
      <nav class="flex items-center justify-between gap-6 border-b border-line py-5">
        <a href="/" class="flex shrink-0 items-center gap-2.5 font-semibold whitespace-nowrap">
          <Logo />
          Pi Display
        </a>
        <div class="flex items-center gap-8">
          <div class="hidden items-center gap-8 text-sm text-muted md:flex">
            {links.map((link) => <a href={link.href} class="hover:text-fg">{link.label}</a>)}
          </div>
          <div class="flex shrink-0 items-center gap-2.5 text-sm whitespace-nowrap">
            <a href="/config" class="flex h-9 items-center rounded-md border border-edge px-3.5 font-medium hover:border-muted">
              Config<span class="hidden sm:inline">&nbsp;generator</span>
            </a>
            <a href="/install" class="flex h-9 items-center rounded-md bg-accent px-3.5 font-semibold text-bg hover:bg-accent/85">
              Install
            </a>
          </div>
        </div>
      </nav>
      <slot />
    </div>
  </body>
</html>
